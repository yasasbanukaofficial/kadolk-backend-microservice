{
  "info": {
    "name": "vehicle-service",
    "description": "Vehicle Service API collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8082",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Vehicle",
      "item": [
        {
          "name": "Get All Vehicles",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vehicle",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vehicle"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Vehicles By User Id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vehicle/user/:userId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vehicle",
                "user",
                ":userId"
              ],
              "variable": [
                {
                  "key": "userId",
                  "value": "1"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Vehicle By Number",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vehicle/number/:vehicleNumber",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vehicle",
                "number",
                ":vehicleNumber"
              ],
              "variable": [
                {
                  "key": "vehicleNumber",
                  "value": "ABC-1234"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Vehicle By Id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vehicle/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vehicle",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Save Vehicle",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"vehicleNumber\": \"ABC-1234\",\n  \"vehicleType\": \"CAR\",\n  \"brand\": \"Toyota\",\n  \"model\": \"Corolla\",\n  \"color\": \"Silver\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/vehicle",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vehicle"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update Vehicle",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleNumber\": \"ABC-1234\",\n  \"vehicleType\": \"CAR\",\n  \"brand\": \"Toyota\",\n  \"model\": \"Corolla\",\n  \"color\": \"Black\",\n  \"status\": \"OUTSIDE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/vehicle/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vehicle",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Register Vehicle Entry",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vehicle/:id/entry",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vehicle",
                ":id",
                "entry"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Register Vehicle Exit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vehicle/:id/exit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vehicle",
                ":id",
                "exit"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete Vehicle",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vehicle/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vehicle",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
